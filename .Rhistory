describeBy(zensus_wide[, 5:13],
group = zensus_wide$Region)
#median comparison
aggregate(zensus_wide[, 5:13],
by = list(Region = zensus_wide$Region),
FUN = median)
#standard deviation is from mean // use MAD comparison
aggregate(zensus_wide[, 5:13],
by = list(Region = zensus_wide$Region),
FUN = mad)
