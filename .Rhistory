geom_density(adjust = 1.4, fill = NA) +
facet_wrap(~ Region) +
scale_fill_manual(values = c("West" = "salmon", "East" = "steelblue")) +
scale_color_manual(values = c("West" = "salmon", "East" = "steelblue")) +
labs(x = "Erwerbstätigkeit GenderGap (PP)", y = "Density", fill = "Region", color = "Region") +
report_theme +
theme(strip.text = element_blank())
ggsave("erwerbstatig_gg_hist_eawe.pdf", pA3a, width = 7, height = 4)
# Figure A3b - Erwerbslosigkeit GenderGap histogram
pA3b <- ggplot(zensus_wide, aes(x = Erwerbslos_GenderGap, fill = Region, color = Region)) +
geom_histogram(alpha = 0.6, position = "identity", bins = 30,
aes(y = after_stat(density))) +
geom_density(adjust = 1.4, fill = NA) +
facet_wrap(~ Region) +
scale_fill_manual(values = c("West" = "salmon", "East" = "steelblue")) +
scale_color_manual(values = c("West" = "salmon", "East" = "steelblue")) +
labs(x = "Erwerbslosigkeit GenderGap (PP)", y = "Density", fill = "Region", color = "Region") +
report_theme +
theme(strip.text = element_blank())
ggsave("erwerbslosig_gg_hist_eawe.pdf", pA3b, width = 7, height = 4)
# Figure A4 - Full pairs plot (all 9 variables)
pairs_data <- zensus_wide[, 5:13]
colnames(pairs_data) <- c(
"Bev.", "Abitur", "OhneAbschl.",
"Abitur.Gap", "Erwerbst.", "Erwerbslos.",
"Nichterw.", "Erwerbst.Gap", "Erwerbslos.Gap"
)
pdf("pairw_scplot_variables_appendix.pdf", width = 7, height = 7)
pairs(pairs_data,
lower.panel = NULL,
col = ifelse(zensus_wide$Region == "East", "steelblue", "salmon"),
pch = 16, cex = 0.5, oma = c(5, 3, 2, 3))
par(xpd = TRUE)
legend("bottom",
legend = c("West", "East"),
col = c("salmon", "steelblue"),
pch = 16, cex = 0.9, bty = "n", horiz = TRUE,
inset = c(0, 0))
dev.off()
list.files(pattern = "\\.pdf$")
list.files(pattern = "\\.pdf$")
